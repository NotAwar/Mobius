[Unit]
Description=Mobius Client Daemon
Documentation=https://docs.mobius.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/mobius-client start --config=/etc/mobius/client.yaml
Restart=always
RestartSec=10
StandardOutput=append:/var/log/mobius/client.log
StandardError=append:/var/log/mobius/client-error.log

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/mobius /var/log/mobius /var/lib/mobius
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
